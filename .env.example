# Copy to .env and fill in real values. Never commit the real .env.
#
# When running via `docker compose up`, DATABASE_URL and REDIS_URL
# are overridden in docker-compose.yml to point at the `postgres` /
# `redis` service names — the values below are for running the app
# directly on the host (e.g. `uvicorn app.main:app --reload`).

# --- Persistence (required) ---
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# --- Security (required) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Groq LLM provider pool (at least one key required for LLM-backed replies) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- Application ---
APP_ENV=development
ENVIRONMENT=development
LOG_JSON=false
AUTO_CREATE_TABLES=false
CORS_ALLOW_ORIGINS=*

# Comma-separated reverse-proxy IPs allowed to set X-Forwarded-For.
# Leave empty unless the app sits behind a known proxy/load balancer.
TRUSTED_PROXIES=

# Development ONLY: allows datasource connections AND website crawling
# against localhost/private addresses (e.g. a locally running merchant
# database or site). NEVER enable in production.
# ALLOW_LOCAL_DATASOURCE_HOSTS=true

# Optional: webhook (Slack/PagerDuty/etc.) notified on unhandled
# exceptions. Leave unset to skip.
ALERT_WEBHOOK_URL=

# --- Stripe billing (optional; /v1/billing/* 503s without it) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Plans (starter/growth/pro) live in the `billing_plans` table, not
# env vars — manage them via PATCH/POST /v1/admin/plans once the app
# is running. STRIPE_PRICE_GROWTH / STRIPE_PRICE_PRO below are only
# read once, by migration 0031, to seed each plan's Stripe Price ID
# from whatever you already had configured; set the price IDs via the
# admin API instead if you're setting this up fresh.
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_PRO=
