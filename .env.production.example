# Production environment template.
#
# Copy to `.env` ON THE SERVER ONLY — never commit the real file.
#   cp .env.production.example .env
#
# Generate the two required secrets locally first:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # example for any other app secret you add later
#
# Differences from .env.example (dev): AUTO_CREATE_TABLES=false,
# ENVIRONMENT=production, LOG_JSON=true, CORS_ALLOW_ORIGINS locked
# to real domains, STORAGE_BACKEND defaults documented for >1 replica.

# --- Persistence (required) ---
# When using docker-compose.prod.yml these two are already set by
# the compose file to point at the `postgres`/`redis` service names
# — only override here if using an external managed DB/Redis.
DATABASE_URL=postgresql://app:CHANGE_ME_STRONG_PASSWORD@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# --- Security (required) ---
CREDENTIAL_ENCRYPTION_KEY=
JWT_SECRET_KEY=
ADMIN_JWT_ACCESS_TOKEN_MINUTES=480

# --- Groq LLM provider pool (add more keys to spread rate limits) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- Stripe billing (required when billing is enabled) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# --- Application ---
APP_ENV=production
ENVIRONMENT=production
LOG_JSON=true

# Schema changes go through `alembic upgrade head` (entrypoint.sh
# already runs this on every container start). Never true in prod.
AUTO_CREATE_TABLES=false

# Comma-separated list of exact origins allowed to call the API from
# a browser. Replace with your real storefront domain(s) — do NOT
# leave this as "*" in production. Example:
#   CORS_ALLOW_ORIGINS=https://mystore.com,https://www.mystore.com
CORS_ALLOW_ORIGINS=

# Set this to the reverse proxy's IP (Caddy/Nginx/load balancer) so
# X-Forwarded-For is honored for accurate client-IP rate limiting.
# With docker-compose.prod.yml, Caddy talks to the api container
# over the compose network — leave empty unless you know the
# specific IP/CIDR your proxy connects from.
TRUSTED_PROXIES=

# Optional: Slack/PagerDuty/etc. webhook notified on unhandled
# exceptions.
ALERT_WEBHOOK_URL=

# --- Object storage for uploaded chat images ---
# "local" only works safely with exactly one API replica and a
# persistent volume (docker-compose.prod.yml mounts one by default).
# Switch to "s3" before scaling to multiple replicas or deploying to
# a platform without a persistent disk.
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=          # only for R2/Spaces/B2/MinIO, not real AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=       # e.g. a CDN in front of the bucket

# --- Postgres container credentials (docker-compose.prod.yml only) ---
# Used by the postgres service itself; keep in sync with the
# password embedded in DATABASE_URL above.
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=app

# --- Caddy (docker-compose.prod.yml only) ---
# Domain Caddy requests a Let's Encrypt certificate for. Must have a
# DNS A/AAAA record pointing at this server before first boot.
DOMAIN=api.example.com
# Email Let's Encrypt uses for expiry/revocation notices.
ACME_EMAIL=you@example.com
